<a href="@Href"
    class="mb-3.75 w-[90%] rounded-[14px] bg-merlot p-3.75 text-center font-semibold text-snow shadow-[0_4px_10px_rgba(0,0,0,0.25)] transition duration-200 hover:-translate-y-0.5 hover:bg-oxblood focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-snow">
    @ChildContent
</a>

@code {
    [Parameter, EditorRequired]
    public string Href { get; set; } = "#";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
