@page "/about"

<PageTitle>About me</PageTitle>

<section class="min-h-dvh text-blush">

    <div class="h-75 bg-crimson bg-cover bg-center bg-no-repeat pt-5" style="background-image: url('images/banner.png')">
        <a href="/" aria-label="Back to home"
            class="inline-block rounded-full bg-page/35 px-4 py-2 font-medium text-snow transition-colors duration-200 hover:bg-page/60 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-snow">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor"
                        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </a>
    </div>

    <div class="mx-auto w-full max-w-[1020px] px-5">
        <div class="mb-10">
            <img class="relative -mt-15 block size-30 rounded-full border-4 border-page bg-poppy object-cover" src="images/profile.jpg" alt="profile-picture" />

            <h1 class="my-5 text-[2rem] font-bold">Benedict</h1>
            <p class="my-4">Cosplayer, programmer, and professional procrastinator.</p>

            <SocialLinks />
        </div>

        @* One column on phones, three from the "sm" breakpoint (640px) up *@
        <div class="mt-4 grid grid-cols-1 gap-4 pb-10 sm:grid-cols-3">
            <div class="rounded-[14px] bg-crimson p-5 text-snow sm:aspect-[4/3]" role="img" aria-label="Photo 1"
                style="background-image: url('images/about-1.jpg')"></div>
            <div class="rounded-[14px] bg-crimson p-5 text-snow sm:aspect-[4/3]" role="img" aria-label="Photo 2"
                style="background-image: url('images/about-2.jpg')"></div>
            <div class="rounded-[14px] bg-crimson p-5 text-snow sm:aspect-[4/3]" role="img" aria-label="Photo 3"
                style="background-image: url('images/about-3.jpg')"></div>
        </div>
    </div>

</section>
